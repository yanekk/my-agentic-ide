#!/usr/bin/env node
// A stand-in for `claude`, first on PATH under the name `claude` in run.sh. It starts
// nothing. It records each call (argv, cwd, and the ledger as it stood at that moment)
// and behaves as FAKE_CLAUDE_MODE says.
import fs from "node:fs";
import path from "node:path";
import { spawn } from "node:child_process";

const args = process.argv.slice(2);
if (args[0] === "--i-am-the-fake") { console.log("fake-claude"); process.exit(0); }

let ledger = null;
try { ledger = JSON.parse(fs.readFileSync(path.join(process.env.COCKPIT_DIR, "calendar-jobs.json"), "utf8")); }
catch { /* no ledger: the test asserts on that */ }
fs.appendFileSync(process.env.FAKE_CLAUDE_LOG, `${JSON.stringify({ args, cwd: process.cwd(), dir: process.env.COCKPIT_DIR, ledger, gitDir: process.env.GIT_DIR, gitWorkTree: process.env.GIT_WORK_TREE })}\n`);

// `-p` prints the final message; `--bg` prints its one line.
const say = () => console.log(args[0] === "-p" ? "FAKE FINAL MESSAGE" : `backgrounded · ab12cd34 · ${args[args.indexOf("-n") + 1]}`);

switch (process.env.FAKE_CLAUDE_MODE) {
  case "trust":
    console.error(`Workspace not trusted. Run claude in ${process.cwd()} once\nsecond line`);
    process.exit(1);
  case "garbled":
    console.log("something Claude never printed before");
    process.exit(0);
  case "stderr-fail":
    console.error("claude said no");
    process.exit(4);
  case "escape-fail":
    console.error("\x1b]0;pwned\x07 bad");
    process.exit(4);
  case "empty":
    process.exit(0);
  case "leaves-child": {
    // Holds this process's stdout open after it has exited, as a forgotten server would.
    const child = spawn("sleep", ["60"], { stdio: "inherit" });
    fs.writeFileSync(process.env.FAKE_CLAUDE_CHILD, String(child.pid));
    child.unref();
    say();
    process.exit(0);
  }
  case "commits":
    // Leaves things a clean removal would refuse: an untracked file, and a commit on the branch.
    fs.writeFileSync("left-behind.txt", "x");
    say();
    break;
  case "silent-fail":
    process.exit(3);
  case "hang":
    setInterval(() => {}, 1000);
    break;
  case "stubborn":
    // A SIGTERM does not end it; the start limit has to end it another way.
    process.on("SIGTERM", () => {});
    setInterval(() => {}, 1000);
    break;
  case "hold": {
    // Until the test releases it, so a second tick can overlap this one.
    const t = setInterval(() => {
      if (fs.existsSync(process.env.FAKE_CLAUDE_RELEASE)) { clearInterval(t); say(); }
    }, 10);
    break;
  }
  case "read-stdin":
    // Real CLIs read a piped stdin to its end: this never finishes if it stays open.
    process.stdin.resume();
    process.stdin.on("end", say);
    break;
  default:
    say();
}
